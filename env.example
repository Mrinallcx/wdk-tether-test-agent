# Copy to .env in this folder. Never commit .env.

# Merchant API key from the PayAgent portal (API credentials).
PAYAGENT_API_KEY=

# Default is https://www.payagent.co
# Use staging or localhost only if that is where the key was created.
# PAYAGENT_BASE_URL=https://www.payagent.co

# Written by: npm run wallets
WDK_SEED_A=
WDK_SEED_B=

# Solana mainnet hop
WDK_USDT_AMOUNT=1
WDK_TARGET_TXS=20
WDK_SLEEP_MS=8000
WDK_MIN_SOL=0.005

# Must be 1 for npm run run to broadcast.
WDK_TEST_SEND=1

# Optional. Public mainnet RPC is used if empty. Prefer your own endpoint.
# SOLANA_RPC_URL=
